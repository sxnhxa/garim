{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UploadTrainSetAndModels",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": [
        "arn:aws:s3:::${S3_BUCKET}/train/*",
        "arn:aws:s3:::${S3_BUCKET}/models/*"
      ]
    },
    {
      "Sid": "DownloadModelsForDockerBuild",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::${S3_BUCKET}/models/*"
    },
    {
      "Sid": "ListModelsPrefixOnly",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::${S3_BUCKET}",
      "Condition": {
        "StringLike": { "s3:prefix": ["models/*"] }
      }
    }
  ]
}
