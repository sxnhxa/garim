{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadWriteEvalSets",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::${S3_BUCKET}/eval/*",
        "arn:aws:s3:::${S3_BUCKET}/eval-hand/*"
      ]
    },
    {
      "Sid": "ListEvalPrefixesOnly",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::${S3_BUCKET}",
      "Condition": {
        "StringLike": { "s3:prefix": ["eval/*", "eval-hand/*"] }
      }
    }
  ]
}
