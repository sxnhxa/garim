{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "MaskedTextOnly",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::${S3_BUCKET}/masked/*"
    },
    {
      "Sid": "ListMaskedPrefixSoMissingObjectIs404",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::${S3_BUCKET}",
      "Condition": { "StringLike": { "s3:prefix": "masked/*" } }
    },
    {
      "Sid": "RequestTableOnly",
      "Effect": "Allow",
      "Action": ["dynamodb:PutItem", "dynamodb:GetItem"],
      "Resource": "arn:aws:dynamodb:${AWS_REGION}:${AWS_ACCOUNT_ID}:table/garim-requests"
    }
  ]
}
